{
  "$schema": "../../schema/action-parity.schema.json",
  "spec_version": "0.1.0",
  "application": {
    "id": "org.u-king.desktop",
    "name": "U-King",
    "version": "0.9.67",
    "description": "U-King shared ActionParity surface for the production GUI and AI-native CLI.",
    "homepage": "https://www.u-king.org"
  },
  "conformance_targets": [
    "AP-1",
    "AP-2"
  ],
  "surfaces": [
    {
      "id": "desktop",
      "kind": "gui",
      "required_for_parity": true,
      "test_driver": "windows-uia-and-webview2",
      "description": "Existing Tauri desktop GUI with stable data-action-id selectors."
    },
    {
      "id": "cli",
      "kind": "cli",
      "required_for_parity": true,
      "description": "Discoverable non-interactive action list, describe, manifest and run commands."
    }
  ],
  "actions": [
    {
      "id": "environment.inspect",
      "title": "Inspect AI development environment",
      "description": "Detect installed AI development commands, desktop apps, portable Node and the active system proxy without changing the machine.",
      "tags": [
        "diagnostics",
        "environment",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": { "type": "object" },
          "npm": { "type": "object" },
          "claude": { "type": "object" },
          "codex": { "type": "object" },
          "git": { "type": "object" },
          "claude_desktop": { "type": "boolean" },
          "codex_app": { "type": "boolean" },
          "portable_node": { "type": "boolean" },
          "system_proxy": { "type": ["string", "null"] }
        },
        "required": [
          "node",
          "npm",
          "claude",
          "codex",
          "git",
          "claude_desktop",
          "codex_app",
          "portable_node",
          "system_proxy"
        ]
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 30000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"environment.inspect\"] -> tauri:command/detect_stack",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run environment.inspect --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "tool.list",
      "title": "List AI tools",
      "description": "Return U-King's tool catalogue and current installation state without installing or launching anything.",
      "tags": [
        "catalogue",
        "tools",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "installed": { "type": "boolean" }
          },
          "required": [
            "id",
            "name",
            "installed"
          ]
        }
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 30000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"tool.list\"] -> tauri:command/list_tools",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run tool.list --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "driver.status",
      "title": "Get AI driver status",
      "description": "Read the active provider and model for Claude, Codex, ClawX and Hermes without returning API keys.",
      "tags": [
        "drivers",
        "providers",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "active": { "type": "object" },
          "claude_model": { "type": ["string", "null"] },
          "codex_model": { "type": ["string", "null"] },
          "clawx_model": { "type": ["string", "null"] },
          "hermes_model": { "type": ["string", "null"] },
          "claude_own_key": { "type": "boolean" },
          "codex_own_key": { "type": "boolean" }
        },
        "required": [
          "active",
          "claude_own_key",
          "codex_own_key"
        ]
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false,
        "notes": "The provider catalogue is intentionally not exposed because custom entries can contain stored API keys."
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 10000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"driver.status\"] -> tauri:command/get_driver_status",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run driver.status --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    }
  ],
  "state": {
    "queries": [
      "environment.inspect",
      "tool.list",
      "driver.status"
    ],
    "events": []
  }
}
