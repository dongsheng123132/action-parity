{
  "$schema": "../../schema/action-parity.schema.json",
  "spec_version": "0.1.0",
  "application": {
    "id": "org.u-king.desktop",
    "name": "U-King",
    "version": "0.9.67",
    "description": "U-King shared ActionParity surface for the production GUI and AI-native CLI.",
    "homepage": "https://www.u-king.org"
  },
  "conformance_targets": [
    "AP-1",
    "AP-2"
  ],
  "surfaces": [
    {
      "id": "desktop",
      "kind": "gui",
      "required_for_parity": true,
      "test_driver": "windows-uia-and-webview2",
      "description": "Existing Tauri desktop GUI with stable data-action-id selectors."
    },
    {
      "id": "cli",
      "kind": "cli",
      "required_for_parity": true,
      "description": "Discoverable non-interactive action list, describe, manifest and run commands."
    }
  ],
  "actions": [
    {
      "id": "environment.inspect",
      "title": "Inspect AI development environment",
      "description": "Detect installed AI development commands, desktop apps, portable Node and the active system proxy without changing the machine.",
      "tags": [
        "diagnostics",
        "environment",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": { "type": "object" },
          "npm": { "type": "object" },
          "claude": { "type": "object" },
          "codex": { "type": "object" },
          "git": { "type": "object" },
          "claude_desktop": { "type": "boolean" },
          "codex_app": { "type": "boolean" },
          "portable_node": { "type": "boolean" },
          "system_proxy": { "type": ["string", "null"] }
        },
        "required": [
          "node",
          "npm",
          "claude",
          "codex",
          "git",
          "claude_desktop",
          "codex_app",
          "portable_node",
          "system_proxy"
        ]
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 30000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"environment.inspect\"] -> tauri:command/detect_stack",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run environment.inspect --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "tool.list",
      "title": "List AI tools",
      "description": "Return U-King's tool catalogue and current installation state without installing or launching anything.",
      "tags": [
        "catalogue",
        "tools",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "installed": { "type": "boolean" }
          },
          "required": [
            "id",
            "name",
            "installed"
          ]
        }
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 30000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"tool.list\"] -> tauri:command/list_tools",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run tool.list --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "driver.status",
      "title": "Get AI driver status",
      "description": "Read the active provider and model for Claude, Codex, ClawX and Hermes without returning API keys.",
      "tags": [
        "drivers",
        "providers",
        "pilot"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "active": { "type": "object" },
          "claude_model": { "type": ["string", "null"] },
          "codex_model": { "type": ["string", "null"] },
          "clawx_model": { "type": ["string", "null"] },
          "hermes_model": { "type": ["string", "null"] },
          "claude_own_key": { "type": "boolean" },
          "codex_own_key": { "type": "boolean" }
        },
        "required": [
          "active",
          "claude_own_key",
          "codex_own_key"
        ]
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false,
        "notes": "Full provider records remain private because custom entries can contain stored API keys; provider.catalog exposes a redacted view."
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 10000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"driver.status\"] -> tauri:command/get_driver_status",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run driver.status --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "provider.catalog",
      "title": "List redacted AI providers",
      "description": "Return provider metadata and whether a saved key exists without returning the key itself.",
      "tags": [
        "catalogue",
        "providers",
        "security"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "name": { "type": "string" },
            "summary": { "type": "string" },
            "openai_base": { "type": "string" },
            "anthropic_base": { "type": ["string", "null"] },
            "model": { "type": "string" },
            "small_model": { "type": "string" },
            "codex_model": { "type": "string" },
            "codex_wire_api": { "type": "string" },
            "key_url": { "type": "string" },
            "key_hint": { "type": "string" },
            "builtin_recharge": { "type": "boolean" },
            "recommended": { "type": "boolean" },
            "builtin": { "type": "boolean" },
            "has_saved_key": { "type": "boolean" }
          },
          "required": [
            "id",
            "name",
            "summary",
            "openai_base",
            "anthropic_base",
            "model",
            "small_model",
            "codex_model",
            "codex_wire_api",
            "key_url",
            "key_hint",
            "builtin_recharge",
            "recommended",
            "builtin",
            "has_saved_key"
          ]
        }
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false,
        "notes": "api_key is structurally absent; only has_saved_key is exposed."
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 10000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"provider.catalog\"] -> tauri:command/list_provider_catalog",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run provider.catalog --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "cleanup.scan",
      "title": "Scan U-King footprints",
      "description": "List U-King core, configuration and AI-tool footprints without deleting or restoring anything.",
      "tags": [
        "cleanup",
        "diagnostics",
        "safety"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string" },
            "group": { "enum": ["core", "config", "aitool"] },
            "name": { "type": "string" },
            "detail": { "type": "string" },
            "safe": { "type": "boolean" },
            "warn": { "type": "string" }
          },
          "required": [
            "id",
            "group",
            "name",
            "detail",
            "safe",
            "warn"
          ]
        }
      },
      "effects": {
        "class": "read",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false,
        "notes": "This action cannot dispatch cleanup.remove or the legacy destructive cleanup runner."
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 60000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"cleanup.scan\"] -> tauri:command/cleanup_scan",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run cleanup.scan --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    },
    {
      "id": "health.report.preview",
      "title": "Preview AI health report",
      "description": "Generate the human-readable support report in memory without writing a desktop file or returning API keys.",
      "tags": [
        "diagnostics",
        "health",
        "support"
      ],
      "input_schema": {
        "type": "object",
        "additionalProperties": false
      },
      "output_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "report": { "type": "string" }
        },
        "required": [
          "report"
        ]
      },
      "effects": {
        "class": "external",
        "risk": "low",
        "reversible": true,
        "confirmation": "never",
        "audit_required": false,
        "notes": "May read the current account balance over the network; it never returns, creates, or activates a device key."
      },
      "execution": {
        "headless": true,
        "idempotent": true,
        "cancellable": false,
        "timeout_ms": 60000,
        "progress_events": false
      },
      "bindings": [
        {
          "surface": "desktop",
          "target": "selector:[data-action-id=\"health.report.preview\"] -> tauri:command/preview_health_report",
          "test": "src-tauri/src/actions.rs"
        },
        {
          "surface": "cli",
          "target": "cli:U-King.exe action run health.report.preview --json --no-input",
          "test": "src-tauri/src/action_cli.rs"
        }
      ]
    }
  ],
  "state": {
    "queries": [
      "environment.inspect",
      "tool.list",
      "driver.status",
      "provider.catalog",
      "cleanup.scan",
      "health.report.preview"
    ],
    "events": []
  }
}
