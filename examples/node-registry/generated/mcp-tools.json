      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "core_execution_id": {
            "type": "string"
          },
          "task": {
            "additionalProperties": false,
            "properties": {
              "done": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "title",
              "tags",
              "done"
            ],
            "type": "object"
          }
        },
        "required": [
          "task",
          "core_execution_id"
        ],
        "type": "object"
