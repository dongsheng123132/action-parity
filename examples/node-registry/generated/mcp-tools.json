            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "name": "task.complete",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "core_execution_id": {
            "type": "string"
          },
          "state_version": {
            "type": "string"
          },
          "task": {
            "additionalProperties": false,
            "properties": {
              "done": {
                "type": "boolean"
              },
              "id": {
                "type": "string"
              },
              "tags": {
                "items": {
                  "type": "string"
