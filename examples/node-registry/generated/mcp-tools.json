      "description": "Permanently delete every completed task.",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "name": "task.purge",
      "outputSchema": {
        "additionalProperties": false,
        "properties": {
          "core_execution_id": {
            "type": "string"
          },
          "removed": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "state_version": {
            "type": "string"
          }
        },
        "required": [
          "removed",
          "state_version",
          "core_execution_id"
        ],
        "type": "object"
      },
