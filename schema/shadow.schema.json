{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shadowcore:shadow:0.1.0",
  "title": "ShadowCore UI Shadow 0.1.0",
  "description": "A redacted, window-scoped observation bundle.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "format", "spec_version", "shadow_id", "run_id", "created_at", "expires_at", "producer", "subject", "capture", "artifacts", "privacy", "links", "required_capabilities", "extensions"],
  "properties": {
    "$schema": { "const": "urn:shadowcore:shadow:0.1.0" },
    "format": { "const": "shadowcore.ui-shadow" },
    "spec_version": { "const": "0.1.0" },
    "shadow_id": { "type": "string", "format": "uuid" },
    "run_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{4,}$" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "expires_at": { "$ref": "#/$defs/timestamp" },
    "producer": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "adapter", "adapter_version"],
      "properties": { "name": { "const": "anycut" }, "version": { "$ref": "#/$defs/version" }, "adapter": { "type": "string", "minLength": 1 }, "adapter_version": { "$ref": "#/$defs/version" } }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["app_id", "app_name", "app_version", "platform", "os_version", "locale", "processes", "window"],
      "properties": {
        "app_id": { "type": "string", "minLength": 1 }, "app_name": { "type": "string", "minLength": 1 }, "app_version": { "type": ["string", "null"] }, "platform": { "const": "windows" }, "os_version": { "type": "string", "minLength": 1 }, "locale": { "type": "string", "minLength": 2 },
        "processes": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/process" } },
        "window": { "type": "object", "additionalProperties": false, "required": ["hwnd", "owner_pid", "title", "bounds_px", "dpi"], "properties": { "hwnd": { "type": "string", "pattern": "^0x[0-9A-Fa-f]+$" }, "owner_pid": { "type": "integer", "minimum": 1 }, "title": { "type": "string", "maxLength": 4096 }, "bounds_px": { "$ref": "#/$defs/rect" }, "dpi": { "type": "integer", "minimum": 48, "maximum": 960 } } }
      }
    },
    "capture": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "crop", "backend", "started_at", "ended_at", "screenshot_at", "tree_at", "skew_ms", "consistency", "status", "tree_status", "image_size_px", "coordinate_space", "warnings"],
      "properties": {
        "scope": { "const": "single-window" }, "crop": { "enum": ["client", "window"] }, "backend": { "enum": ["wgc", "printwindow"] }, "started_at": { "$ref": "#/$defs/timestamp" }, "ended_at": { "$ref": "#/$defs/timestamp" }, "screenshot_at": { "$ref": "#/$defs/timestamp" }, "tree_at": { "anyOf": [{ "$ref": "#/$defs/timestamp" }, { "type": "null" }] }, "skew_ms": { "type": ["integer", "null"], "minimum": 0 }, "consistency": { "enum": ["within-budget", "uncertain"] }, "status": { "enum": ["complete", "partial"] }, "tree_status": { "enum": ["complete", "partial", "unavailable"] }, "image_size_px": { "$ref": "#/$defs/size" }, "coordinate_space": { "const": "screenshot-physical-px" }, "warnings": { "type": "array", "items": { "$ref": "#/$defs/warning" } }
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["screenshot.png", "ui-tree.json", "window.json", "actions.json", "state.json", "regions.json", "context.md"],
      "properties": {
        "screenshot.png": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "image/png" } } }] },
        "ui-tree.json": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "application/json" } } }] },
        "window.json": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "application/json" } } }] },
        "actions.json": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "application/json" } } }] },
        "state.json": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "application/json" } } }] },
        "regions.json": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "application/json" } } }] },
        "context.md": { "allOf": [{ "$ref": "#/$defs/artifact" }, { "properties": { "media_type": { "const": "text/markdown" } } }] }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false, "required": ["purpose", "redaction", "retention", "egress", "interaction_policy"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1, "maxLength": 1024 },
        "redaction": { "type": "object", "additionalProperties": false, "required": ["mode", "ruleset_version", "status", "mask_count", "text_replacement_count", "unresolved_count"], "properties": { "mode": { "const": "auto" }, "ruleset_version": { "$ref": "#/$defs/version" }, "status": { "enum": ["passed", "needs-review"] }, "mask_count": { "type": "integer", "minimum": 0 }, "text_replacement_count": { "type": "integer", "minimum": 0 }, "unresolved_count": { "type": "integer", "minimum": 0 } } },
        "retention": { "type": "object", "additionalProperties": false, "required": ["ttl_seconds", "enforcement", "cleanup"], "properties": { "ttl_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 }, "enforcement": { "const": "deny-after-expiry" }, "cleanup": { "const": "best-effort" } } },
        "egress": { "type": "object", "additionalProperties": false, "required": ["default", "approval_required", "grant_ref"], "properties": { "default": { "const": "deny" }, "approval_required": { "const": true }, "grant_ref": { "type": ["string", "null"] } } }, "interaction_policy": { "const": "observe-only" }
      }
    },
    "links": { "type": "object", "additionalProperties": false, "required": ["action_parity", "task_passport"], "properties": { "action_parity": { "type": ["object", "null"] }, "task_passport": { "type": ["object", "null"] } } },
    "required_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" } },
    "extensions": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$" }, "additionalProperties": true }
  },
  "$defs": {
    "timestamp": { "type": "string", "format": "date-time" }, "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "rect": { "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } } },
    "size": { "type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": { "width": { "type": "integer", "minimum": 1, "maximum": 32768 }, "height": { "type": "integer", "minimum": 1, "maximum": 32768 } } },
    "process": { "type": "object", "additionalProperties": false, "required": ["pid", "image_name"], "properties": { "pid": { "type": "integer", "minimum": 1 }, "image_name": { "type": "string", "minLength": 1 }, "image_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] } } },
    "artifact": { "type": "object", "additionalProperties": false, "required": ["path", "media_type", "bytes", "sha256"], "properties": { "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" }, "media_type": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 }, "sha256": { "$ref": "#/$defs/sha256" } } },
    "warning": { "type": "object", "additionalProperties": false, "required": ["code", "message"], "properties": { "code": { "type": "string", "minLength": 1 }, "message": { "type": "string", "minLength": 1 } } }
  }
}
