{
  "name": "action-parity",
  "version": "0.6.0",
  "description": "Open standard and validator for one action across GUI, CLI, MCP, automation, and AI.",
  "keywords": [
    "actionparity",
    "action-parity",
    "shadowcore",
    "影核",
    "action-core",
    "agent-native",
    "gui-cli-parity",
    "mcp",
    "conformance"
  ],
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "action-parity": "./bin/action-parity.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "schema/",
    "SPEC.md",
    "LICENSE",
    "README.md",
    "README.zh-CN.md"
  ],
  "scripts": {
    "check": "npm test && npm run test:rust && npm run validate && npm run check:links",
    "check:links": "node scripts/check-links.mjs",
    "validate": "node bin/action-parity.mjs validate examples/minimal/action-parity.json && node bin/action-parity.mjs validate examples/u-king/action-parity.json",
    "report": "node bin/action-parity.mjs report examples/u-king/action-parity.json",
    "generate:rust-example": "node scripts/generate-rust-example.mjs",
    "test": "node --test test/validator.test.mjs test/verifier.test.mjs",
    "test:rust": "cargo test --workspace"
  },
  "dependencies": {
    "ajv": "^8.17.1"
  }
}
